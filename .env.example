# TrAI Platform — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env — it is already in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Spring profile  (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:       mongodb://localhost:27017/trai
# Google Cloud (MongoDB Atlas or self-hosted on Cloud Run):
#              mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/trai

# ─── Redis (Google Cloud Memorystore) ─────────────────────────────────────────
# Local:            localhost
# Cloud Memorystore: <memorystore-ip-from-console>
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── xAI Grok-2 (PRIMARY AI ENGINE — Twitter/X-sourced real tweets) ───────────
# Get from: https://console.x.ai
XAI_API_KEY=xai_REPLACE_WITH_YOUR_KEY

# ─── Twitter/X API v2 (for real-time tweet scraping per country) ──────────────
# Get from: https://developer.twitter.com/en/portal/dashboard
# Requires Elevated or Academic access for search/stream endpoints
TWITTER_BEARER_TOKEN=REPLACE_WITH_TWITTER_BEARER_TOKEN
TWITTER_API_KEY=REPLACE_WITH_TWITTER_API_KEY
TWITTER_API_SECRET=REPLACE_WITH_TWITTER_API_SECRET

# ─── Google Cloud Vertex AI Gemini 2.0 ────────────────────────────────────────
# Project ID from: https://console.cloud.google.com
# Enable Vertex AI API and create a Service Account key (JSON), then:
#   export GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Or set directly:
GEMINI_PROJECT_ID=REPLACE_WITH_YOUR_GCP_PROJECT_ID
GEMINI_LOCATION=us-central1
# Model: gemini-2.0-flash-exp or gemini-1.5-pro (set in application.yml)

# ─── OpenAI ChatGPT (GPT-4o) ──────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_WITH_OPENAI_API_KEY

# ─── Google Cloud Storage (replaces Yandex Object Storage) ───────────────────
# Bucket for media/file uploads — create in Google Cloud Console → Cloud Storage
GCS_BUCKET_NAME=trai-media
# Service account key is used via GOOGLE_APPLICATION_CREDENTIALS
# Or set explicit credentials:
GCS_PROJECT_ID=${GEMINI_PROJECT_ID}

# ─── Firebase Cloud Messaging (Push Notifications — Android + iOS) ────────────
# Get from: https://console.firebase.google.com → Project Settings → Service Accounts
# Download google-services.json (Android) and GoogleService-Info.plist (iOS)
# and place them in mobile/android/app/ and mobile/ios/Runner/ respectively
FCM_SERVER_KEY=REPLACE_WITH_FCM_SERVER_KEY
# Or use Firebase Admin SDK service account JSON path:
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong random secret (min 256 bits):
#   openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRATION_MS=86400000

# ─── B2B Webhook Signing ──────────────────────────────────────────────────────
# Used to verify inbound webhook signatures (HMAC-SHA256)
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_WEBHOOK_SIGNING_SECRET

# ─── Google Cloud Deployment (used by CI/CD) ──────────────────────────────────
# GCP Project + region for Cloud Run deployment
GCP_PROJECT_ID=REPLACE_WITH_GCP_PROJECT_ID
GCP_REGION=us-central1
GCP_CLOUD_RUN_SERVICE=trai-backend
GCP_ARTIFACT_REGISTRY=us-central1-docker.pkg.dev
