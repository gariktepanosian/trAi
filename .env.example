# TrAI Platform — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env — it is already in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Spring profile  (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:       mongodb://localhost:27017/trai
# Yandex MDB:  mongodb://<user>:<password>@<host>:27018/trai?tls=true
MONGODB_URI=mongodb://localhost:27017/trai

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── xAI Grok-2 (PRIMARY AI ENGINE) ──────────────────────────────────────────
# Get from: https://console.x.ai
XAI_API_KEY=xai_REPLACE_WITH_YOUR_KEY

# ─── Google Cloud Vertex AI Gemini (SECONDARY AI ENGINE) ─────────────────────
# Project ID from: https://console.cloud.google.com
GEMINI_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
GEMINI_LOCATION=us-central1

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong random secret (min 256 bits):
#   openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRATION_MS=86400000

# ─── Yandex Object Storage (for media/file uploads) ──────────────────────────
# Get from: Yandex Cloud Console → Object Storage → Access Keys
YANDEX_STORAGE_KEY=REPLACE_WITH_YANDEX_STORAGE_ACCESS_KEY
YANDEX_STORAGE_SECRET=REPLACE_WITH_YANDEX_STORAGE_SECRET_KEY
YANDEX_STORAGE_BUCKET=trai-media

# ─── B2B Webhook Signing ──────────────────────────────────────────────────────
# Used to verify inbound webhook signatures (HMAC-SHA256)
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_WEBHOOK_SIGNING_SECRET
